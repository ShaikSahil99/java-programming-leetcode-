package sample;
import java.util.*;
public class learning {

	static Scanner z=new Scanner(System.in);

	public static void main(String[] args) 
	{
		int n=z.nextInt();
		for(int i=1;i<=n;i++)
		{
			for(int j=1;j<=n;j++)
			{
				if(i==1 || j==(n+1)/2 || (j==i && i>(n+1)/2))
				{
					System.out.print("*");
				}
				else
				{
					System.out.print(" ");
				}
			}
			System.out.println();
		}
	}
}

