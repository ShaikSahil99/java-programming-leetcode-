package sample;
import java.util.*;
public class learning {

	static Scanner z=new Scanner(System.in);

	public static void main(String[] args) 
	{
		int n=z.nextInt();
		for(int i=1;i<=n;i++)
		{
			for(int j=1;j<=n;j++)
			{
				if(j<=i-1)
				{
					System.out.println(" ");
				}
				else
				{
					System.out.println("*");
				}
			}
		}
	}
}

