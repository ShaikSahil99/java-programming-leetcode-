package sample;
import java.util.*;
public class learning {

	static Scanner z=new Scanner(System.in);
	public static void main(String[] args) 
	{
		int x=z.nextInt();
		int y=z.nextInt();
		int c=0;
		int t=x;
		int sum=0;
		while(t>0)
		{
			t=t/10;
			c++;
		}
		while(x<=y)
		{
			t=x;
			sum=0;
			System.out.println(" *"+t+"* ");
			while(t>0)
			{
				int r=t%10;
				t=t/10;
				sum=sum+(int)Math.pow(r,c);
			}
			if(sum==x)
			{
				System.out.print(x+" ");
			}
			
			System.out.println(x+"       "+y+"          "+sum);
			x++;
		}
	}
}
