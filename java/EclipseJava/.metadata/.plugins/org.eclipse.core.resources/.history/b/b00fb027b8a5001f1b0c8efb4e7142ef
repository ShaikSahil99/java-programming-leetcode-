package sample;
import java.util.*;
public class learning {

	static Scanner z=new Scanner(System.in);

	public static void main(String[] args) 
	{
		int n=z.nextInt();
		int min1=0,min2=0;
		int a[]=new int[n];
		int min=Integer.MAX_VALUE;
		for(int i=0;i<n;i++)
		{
			a[i]=z.nextInt();
		}
		for(int i=0;i<n;i++)
		{
			if(a[i]<min)
			{
				min2=min1;
				min1=min;
				min=a[i];
			}
			else if(a[i]>min && a[i]<min1)
			{
				min2=min1;
				min1=a[i];
			}
			else if(a[i]>min1 && a[i]<min2)
			{
				min2=a[i];
			}
		}
		System.out.print(min+" "+min1+" "+min2);
	}
}
 
